# PostgreSQL connection string (Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
SESSION_SECRET="replace-with-32-byte-random-secret"

# Google Sign-In (OAuth 2.0 Web client). Leave blank to hide working Google login until configured.
# Redirect URI must be: {origin}/api/auth/google/callback (e.g. https://www.jhonnysurfstore.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_EMAILS="jhonnysurfstore@gmail.com"

# Welcome + paid-order SMS (Twilio). Without these, SMS is logged as SKIPPED.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Jhonny's mobile for paid-order alerts (E.164, e.g. +351912345678). Never commit the real number.
JHONNY_SMS_PHONE=""

# Public launch gate. Production shows /coming-soon until SITE_PUBLIC_LAUNCH=open.
# Unlock the full site for yourself at /preview-access using SITE_PREVIEW_PASSWORD.
# Local `next dev` stays open unless SITE_COMING_SOON=true.
# SITE_PUBLIC_LAUNCH=true is ignored (too easy to leave on by accident).
SITE_PUBLIC_LAUNCH="false"
SITE_PREVIEW_PASSWORD="replace-with-a-long-private-preview-password"
# SITE_COMING_SOON="true"

# Odoo ecommerce integration. Keep these server-side only.
ODOO_URL="https://jhonny-surf.odoo.com"
ODOO_DB="jhonny-surf-master-26611951"
ODOO_USERNAME="jhonnysurfstore@gmail.com"
ODOO_API_KEY="replace-with-odoo-api-key"
ODOO_LIVE_CATALOG="false"
ODOO_AUTO_CONFIRM_SALE_ORDER="true"
ODOO_CREATE_INVOICE_AFTER_PAYMENT="true"
# Paid website orders are registered as POS sales on this till so Odoo issues
# the same fatura-recibo as a finished shop sale (Ponto de Venda → Encomendas).
ODOO_POS_CONFIG_NAME="Loja Carcavelos"
# Optional service product used as the Portes line on the official fatura.
# ODOO_SHIPPING_PRODUCT_ID=""
# Optional: force a POS payment method id. Otherwise we pick a non-cash / bank method.
# ODOO_POS_PAYMENT_METHOD_ID=""
# Paid orders validate Odoo deliveries by default so qty_available drops immediately.
# Set to "false" only as an emergency opt-out. Website POS registration skips this path.
ODOO_AUTO_VALIDATE_DELIVERY="true"
# After payment, register a Loja Carcavelos POS sale (Faturado) and attach the official PDF.
# Protects /api/odoo/sync/products and /api/cron/abandoned-cart
# (Vercel Cron sends Authorization: Bearer $CRON_SECRET).
CRON_SECRET="replace-with-long-random-cron-secret"
# Local/dev only: shorten the 24h abandoned-cart wait. Do not set 0 in production.
# ABANDONED_CART_MIN_AGE_HOURS="24"
# Optional alias if you prefer a dedicated sync secret instead of CRON_SECRET.
# ODOO_SYNC_SECRET="replace-with-long-random-sync-secret"
# Set true only for local demos. Production never sells mock/DEMO products.
# ALLOW_MOCK_CATALOG="true"

# Ifthenpay covers MB WAY and Multibanco when these account keys are enabled.
IFTHENPAY_MBWAY_KEY="replace-with-ifthenpay-mbway-key"
IFTHENPAY_MB_KEY="replace-with-ifthenpay-multibanco-key-or-dynamic-key"
IFTHENPAY_BACKOFFICE_KEY="replace-with-ifthenpay-backoffice-key-if-needed"
IFTHENPAY_CALLBACK_SECRET="replace-with-ifthenpay-callback-secret-or-anti-phishing-key"
IFTHENPAY_CALLBACK_URL="https://www.jhonnysurfstore.com/api/payments/ifthenpay/callback"

# Optional providers if Jhonny enables them separately.
PAYPAL_CLIENT_ID="replace-with-paypal-client-id"
PAYPAL_CLIENT_SECRET="replace-with-paypal-client-secret"
PAYPAL_WEBHOOK_ID="replace-with-paypal-webhook-id"
PAYPAL_ENVIRONMENT="sandbox"

# Stripe Checkout covers card, Google Pay, Revolut Pay and Klarna.
# Use pk_test_/sk_test_ until the integration is verified, then live keys.
STRIPE_SECRET_KEY="sk_test_replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-stripe-webhook-signing-secret"
# Optional: the Dashboard configuration ID for "Sua conta" (pmc_...).
# STRIPE_PAYMENT_METHOD_CONFIGURATION="pmc_replace-with-default-config-id"
# STRIPE_WEBHOOK_URL="https://www.jhonnysurfstore.com/api/payments/stripe/webhook"

# Transactional email provider. For Gmail, use a Google App Password, not the normal Gmail password.
# Signup (email/password or Google) does not send a confirmation link.
# Welcome email/SMS fire after the client fills name, phone and address in My Data.
# SMTP and Resend fall back to each other when the preferred provider is missing or fails.
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="replace-with-gmail-address"
SMTP_PASSWORD="replace-with-google-app-password"
# Must use the same mailbox domain as SMTP_USER. A shop domain here is rewritten
# at send time so iCloud/Outlook do not drop the paid fatura email.
EMAIL_FROM="Jhonny Surf Store <replace-with-gmail-address>"
JHONNY_ORDER_EMAIL="jhonnysurfstore@gmail.com"

# Optional Resend fallback if we decide to use a transactional email provider instead of Gmail.
RESEND_API_KEY="replace-with-resend-api-key"

# Optional YouTube Data API key for refreshing surfboard review video titles.
# Leave empty to skip cache refresh; matching still uses the committed JSON.
YOUTUBE_API_KEY=""

# Instagram Graph API-ready media integration.
# For each handle, add INSTAGRAM_<HANDLE>_ACCOUNT_ID where non-alphanumeric chars become underscores.
INSTAGRAM_GRAPH_ACCESS_TOKEN="replace-with-instagram-graph-token"
# Connected Instagram business/creator account used to discover public business/creator profile photos.
INSTAGRAM_GRAPH_SOURCE_ACCOUNT_ID="replace-with-connected-instagram-account-id"
INSTAGRAM_DUDES_SURFCAFE_ACCOUNT_ID="replace-with-dudes-instagram-account-id"
# Optional static fallback JSON when Graph API is not connected:
# INSTAGRAM_DUDES_SURFCAFE_MEDIA_JSON='[{"id":"1","mediaUrl":"https://...","permalink":"https://www.instagram.com/p/..."}]'
# Optional direct athlete avatar URLs when you export/copy profile photos:
# INSTAGRAM_MADALENAMGUERREIRO_AVATAR_URL="https://..."
# INSTAGRAM__MELENDEZZZ_AVATAR_URL="https://..."
